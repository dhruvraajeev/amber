# Settings Amber reads from the process environment. Nothing loads a .env file for you: export these in
# your shell, or pass them with `docker run -e` / `az containerapp update --set-env-vars`. None is required.
# Never put secrets in this file or in chat; they go in your own .env (gitignored), GitHub secrets, or Azure.

# API: "dev" allows the Vite dev server (localhost:5173) to call the API on :8000 directly (CORS).
AMBER_ENV=

# API: the commit the image was built from, reported by /healthz. The publish workflow sets it.
AMBER_SHA=

# API: proxies whose X-Forwarded-For is trusted for the client IP. The Dockerfile sets private ranges;
# never use "*", or anyone could dodge the per-address rate limit.
FORWARDED_ALLOW_IPS=

# MCP server: which Amber it talks to (and links to). Defaults to the live app.
AMBER_API_URL=
