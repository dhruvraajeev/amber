{
  "description": "Self-hosted Llama 3.1 8B FP16 (16.1 GB of weights) on a 16 GB T4: no room left for the KV cache.",
  "expect": [
    "PARAM_RANGE"
  ],
  "config": {
    "durationS": 60,
    "seed": 42,
    "warmupS": 5
  },
  "design": {
    "name": "model-does-not-fit",
    "version": 1,
    "nodes": [
      {
        "id": "users",
        "kind": "users",
        "label": "users",
        "position": { "x": 0, "y": 0 },
        "params": { "traffic": { "type": "constant", "rps": 1 }, "clientTimeoutMs": 60000 }
      },
      {
        "id": "api",
        "kind": "service",
        "label": "api",
        "position": { "x": 200, "y": 0 },
        "params": {
          "replicas": 1,
          "concurrencyPerReplica": 50,
          "queueLimit": 200,
          "work": { "p50Ms": 10, "p99Ms": 60 },
          "costPerReplicaMonth": 30
        }
      },
      {
        "id": "llm",
        "kind": "llm",
        "label": "LLM",
        "position": { "x": 400, "y": 0 },
        "params": {
          "mode": "selfHosted",
          "gpuPresetId": "nvidia-t4-16gb",
          "modelPresetId": "llama-3.1-8b-instruct-fp16",
          "profileId": "default",
          "replicas": 1,
          "maxBatchSize": 32,
          "maxBatchTokens": 4096,
          "maxOutputTokensReserve": 512,
          "speculative": { "enabled": false, "draftTokens": 4, "acceptanceRate": 0.7, "draftStepMs": 3 }
        }
      }
    ],
    "edges": [
      { "id": "e_users_api", "source": "users", "target": "api" },
      { "id": "e_api_llm", "source": "api", "target": "llm" }
    ]
  }
}
